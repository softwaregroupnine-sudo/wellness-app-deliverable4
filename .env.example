

# --- Required: AI features (Groq) ---
GROQ_API_KEY=

# --- Required: signs the password-reset links (any long random text) ---
SECRET_KEY=

# --- Optional: email for "Forgot password" ---
# Without these, the reset link is printed in the Flask terminal instead.
# For Gmail, SMTP_PASSWORD must be an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

